# ---------------------------------------------------------------------------
# Frontend environment variables (Vite exposes only VITE_* values)
# Copy this file to .env and fill in your project values.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser; protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Stripe test-mode publishable key, e.g. pk_test_...
# Optional: the current card form is simulated and does not use Stripe.
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-only key used by `npm run seed:admin`.
# Keep this in .env.local (gitignored), never in .env or src/.
SUPABASE_SERVICE_ROLE_KEY=
